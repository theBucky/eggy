{
  "name": "eggy",
  "version": "1.0.0",
  "description": "Keeps installed applications, Homebrew packages, and local git repositories up to date.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "revolt",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "install-electron",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:mac": "pnpm build && electron-builder --mac"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@oxlint/plugins": "1.93.0",
    "@pierre/diffs": "^1.6.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabler/icons-svelte": "^3.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@xmldom/xmldom": "^0.9.12",
    "bits-ui": "^2.20.6",
    "cn": "^0.5.2",
    "dompurify": "^3.4.17",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.2.0",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "semver": "^7.8.6",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
