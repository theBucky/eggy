{
  "name": "electron-app",
  "version": "1.0.0",
  "description": "An Electron application with Svelte and TypeScript",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "svelte-check --tsconfig ./tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@oxlint/plugins": "1.90.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabler/icons-svelte": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.20.3",
    "cn": "^0.5.2",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
