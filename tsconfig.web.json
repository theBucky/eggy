{
  "extends": "./tsconfig.json",
  "include": ["src/renderer", "src/shared"],
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["svelte", "vite/client"],
    "paths": {
      "$shell/*": ["./src/renderer/shell/*"],
      "$features/*": ["./src/renderer/features/*"],
      "$source/*": ["./src/renderer/source/*"],
      "$client/*": ["./src/renderer/client/*"],
      "$primitives/*": ["./src/renderer/primitives/*"],
      "$shared/*": ["./src/shared/*"]
    }
  }
}
