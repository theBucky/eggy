{
  "extends": "./tsconfig.json",
  "include": [
    "electron.vite.config.ts",
    "src/main",
    "src/preload",
    "src/shared",
    "tools/oxlint/boundaries"
  ],
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node", "electron-vite/node"],
    "paths": {
      "$platform/*": ["./src/main/platform/*"],
      "$shared/*": ["./src/shared/*"]
    }
  }
}
